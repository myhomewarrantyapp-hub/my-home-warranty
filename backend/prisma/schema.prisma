generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  USER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}
enum RecordStatus {
  ACTIVE
  PENDING
  COMPLETED
  CANCELLED
}
model User {
 id String @id @default(cuid())
 name String
 email String? @unique
 mobile String? @unique
 passwordHash String
 role UserRole @default(USER)
 isActive Boolean @default(true)
 preferredLanguage String @default("en")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 assets Asset[]
 vehicles Vehicle[]
 bills Bill[]
 moneyEntries MoneyEntry[]
 paymentRequests PaymentRequest[]
 insurancePolicies InsurancePolicy[]
 documents Document[]
 reminders Reminder[]
 auditAsActor AuditEvent[] @relation("AuditActor")
 supportTickets SupportTicket[]
}
model Asset {
 id String @id @default(cuid())
 ownerUserId String
 title String
 category String
 purchaseDate DateTime?
 warrantyEnd DateTime?
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,createdAt])
}
model Vehicle {
 id String @id @default(cuid())
 ownerUserId String
 nickname String
 makeModel String?
 registrationLastFour String?
 currentOdometer Int?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 events VehicleEvent[]
 @@index([ownerUserId])
}
model VehicleEvent {
 id String @id @default(cuid())
 vehicleId String
 ownerUserId String
 eventType String
 eventDate DateTime
 odometer Int?
 cost Decimal? @db.Decimal(12,2)
 notes String?
 nextDueDate DateTime?
 nextDueOdometer Int?
 createdAt DateTime @default(now())
 vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,vehicleId,eventDate])
}
model Bill {
 id String @id @default(cuid())
 ownerUserId String
 billType String
 provider String?
 amount Decimal @db.Decimal(12,2)
 billDate DateTime?
 dueDate DateTime
 status RecordStatus @default(PENDING)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,dueDate])
}
model MoneyEntry {
 id String @id @default(cuid())
 ownerUserId String
 direction String
 personName String
 mobile String?
 amount Decimal @db.Decimal(12,2)
 entryDate DateTime
 dueDate DateTime?
 interestRate Decimal? @db.Decimal(7,3)
 balance Decimal @db.Decimal(12,2)
 status RecordStatus @default(PENDING)
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,dueDate])
}
model PaymentRequest {
 id String @id @default(cuid())
 ownerUserId String
 recipientName String
 recipientMobile String?
 amount Decimal @db.Decimal(12,2)
 purpose String?
 status String @default("CREATED")
 providerReference String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,status])
}
model InsurancePolicy {
 id String @id @default(cuid())
 ownerUserId String
 insurer String
 policyType String
 policyNumberEncrypted String?
 startDate DateTime?
 endDate DateTime?
 premiumAmount Decimal? @db.Decimal(12,2)
 premiumDue DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,endDate])
}
model Document {
 id String @id @default(cuid())
 ownerUserId String
 storageKey String @unique
 originalName String
 mimeType String
 sizeBytes Int
 checksumSha256 String
 scanStatus String @default("PENDING_SCAN")
 createdAt DateTime @default(now())
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,createdAt])
}
model Reminder {
 id String @id @default(cuid())
 ownerUserId String
 title String
 description String?
 dueAt DateTime
 remindAt DateTime
 status RecordStatus @default(PENDING)
 deliveryStatus String @default("QUEUED")
 createdAt DateTime @default(now())
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,remindAt])
}
model AuditEvent {
 id String @id @default(cuid())
 actorUserId String
 action String
 entityType String
 entityId String?
 outcome String @default("SUCCESS")
 ipAddress String?
 userAgent String?
 createdAt DateTime @default(now())
 actor User @relation("AuditActor",fields:[actorUserId],references:[id],onDelete:Restrict)
 @@index([actorUserId,createdAt])
}
model SupportTicket {
 id String @id @default(cuid())
 ownerUserId String
 subject String
 message String
 status String @default("OPEN")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerUserId],references:[id],onDelete:Cascade)
 @@index([ownerUserId,status])
}
model SiteControl {
 id String @id @default("main")
 visibility String @default("PUBLIC")
 maintenanceMode Boolean @default(false)
 notice String @default("The website is temporarily unavailable. Please try again later.")
 updatedAt DateTime @updatedAt
}